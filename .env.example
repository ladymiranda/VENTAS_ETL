# Copia este archivo a ".env" (sin .example) y ajusta los valores.
# ".env" NUNCA se sube a git (está en .gitignore) — este .example sí,
# como plantilla para que cualquiera que clone el repo sepa qué configurar.

# Entorno de ejecucion: development | production
APP_ENV=development

# Nivel de logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Puerto local para "streamlit run dashboard.py" (opcional, Streamlit Cloud lo ignora)
STREAMLIT_SERVER_PORT=8501

# --------------------------------------------------------------------------
# Hoy el proyecto no usa API keys ni credenciales de base de datos externas
# (DuckDB es un archivo local en output/ventas.duckdb). Si en el futuro
# agregas una fuente que sí las necesite (otra API, otra base de datos,
# notificaciones por correo/Slack si falla el ETL, etc.), esas claves van
# aca, nunca hardcodeadas en el codigo ni commiteadas.
# --------------------------------------------------------------------------
